# Copie para .env e ajuste os valores. NUNCA commite o .env no Git.

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema
DB_USER=sistema_user
DB_PASS=troque_esta_senha

# Groq: preencha apenas no servidor
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Habilite apenas durante o cadastro controlado de um diretor
ALLOW_DIRECTOR_REGISTRATION=false
# Em produção com vários workers, use armazenamento compartilhado (ex.: Redis).
RATELIMIT_STORAGE_URI=memory://
